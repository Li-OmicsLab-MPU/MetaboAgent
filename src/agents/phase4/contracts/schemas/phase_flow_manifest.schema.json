{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaboagent.local/schemas/phase_flow_manifest.schema.json",
  "title": "MetaboAgent Phase Flow Manifest",
  "description": "Run-scoped data lineage, evidence scope and phase-boundary contract for Phase 0-4 reporting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "study", "artifacts", "nodes", "edges", "policy"],
  "properties": {
    "schema_version": {"const": "metaboagent.phase_flow.v1"},
    "run_id": {"$ref": "#/$defs/nonEmptyString"},
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disease", "intended_use", "outcome"],
      "properties": {
        "disease": {"$ref": "#/$defs/nonEmptyString"},
        "study_id": {"type": ["string", "null"]},
        "intended_use": {"$ref": "#/$defs/nonEmptyString"},
        "outcome": {"$ref": "#/$defs/nonEmptyString"},
        "specimen": {"type": ["string", "null"]},
        "platform": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"},
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"},
      "minItems": 5
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_order", "external_validation_rule", "missing_artifact_rule"],
      "properties": {
        "phase_order": {
          "type": "array",
          "const": ["phase0", "phase1", "phase2", "phase3", "phase4"]
        },
        "external_validation_rule": {
          "const": "Only an explicitly declared external cohort may be labelled external."
        },
        "missing_artifact_rule": {
          "const": "Missing evidence is rendered as not_archived and cannot be inferred."
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": ["phase0", "phase1", "phase2", "phase3", "phase4"]
    },
    "scope": {
      "enum": ["raw", "train_only", "development_cv", "internal_holdout", "external", "mixed"]
    },
    "fitScope": {
      "enum": ["none", "train_only", "within_training_fold", "full_development", "external_only", "mixed"]
    },
    "status": {
      "enum": ["complete", "partial", "planned", "not_archived", "failed"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "status", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {
          "enum": ["raw_matrix", "metadata", "split_manifest", "table", "model", "prediction", "metric", "figure", "report", "json", "other"]
        },
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "status": {"$ref": "#/$defs/status"},
        "scope": {"$ref": "#/$defs/scope"},
        "produced_by": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "label", "inputs", "outputs", "sample_scope", "fit_scope", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "phase": {"$ref": "#/$defs/phase"},
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "sample_scope": {"$ref": "#/$defs/scope"},
        "fit_scope": {"$ref": "#/$defs/fitScope"},
        "status": {"$ref": "#/$defs/status"},
        "n_samples_in": {"type": ["integer", "null"], "minimum": 0},
        "n_samples_out": {"type": ["integer", "null"], "minimum": 0},
        "n_features_in": {"type": ["integer", "null"], "minimum": 0},
        "n_features_out": {"type": ["integer", "null"], "minimum": 0},
        "decision_effect": {"enum": ["none", "descriptive_only", "changes_candidates", "changes_model", "creates_report"]},
        "evidence_boundary": {"type": ["string", "null"]},
        "stage_summary": {"$ref": "#/$defs/stageSummary"}
      }
    },
    "stageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "items"],
      "properties": {
        "headline": {"$ref": "#/$defs/nonEmptyString"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": {"$ref": "#/$defs/nonEmptyString"},
              "value": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "artifact_id"],
      "properties": {
        "from": {"$ref": "#/$defs/nonEmptyString"},
        "to": {"$ref": "#/$defs/nonEmptyString"},
        "artifact_id": {"$ref": "#/$defs/nonEmptyString"},
        "label": {"type": ["string", "null"]}
      }
    }
  }
}
